{
  "name": "nezuko-voip",
  "version": "2.1.0",
  "description": "VoIP facade backed by nezuko-baileys for WhatsApp bots.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "smoke": "node examples/smoke.js",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "voip",
    "call",
    "whatsapp-bot",
    "esm"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mzml-gg/nezuko-voip.git"
  },
  "bugs": {
    "url": "https://github.com/mzml-gg/nezuko-voip/issues"
  },
  "homepage": "https://github.com/mzml-gg/nezuko-voip#readme",
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "github:mzml-gg/nezuko-baileys#v1.0.2"
  },
  "x-compatibility": {
    "canonicalImport": "@whiskeysockets/baileys",
    "implementation": "github:mzml-gg/nezuko-baileys#v1.0.2",
    "voipImport": "@whiskeysockets/baileys/voip"
  }
}
